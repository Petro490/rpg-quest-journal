# === Конфигурация RPG Quest Journal ===
# Скопируйте этот файл в .env и подставьте свои значения.

# Режим работы: development | production
RPG_ENV=development

# Хост и порт, на которых слушает сервер
RPG_HOST=127.0.0.1
RPG_PORT=8000

# Секретный ключ сессий. ОБЯЗАТЕЛЬНО задайте уникальное значение в продакшене!
RPG_SECRET=change-me-to-a-long-random-string